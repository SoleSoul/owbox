#!/bin/sh
# Start an owbox session, like openbox-session does for Openbox: set up the
# environment and run owbox.  owbox runs the autostart itself.
#
# The environment comes from the system's and then the user's environment
# file (shell variable assignments, eg "export LANG=en_US.UTF-8"):
#   /etc/xdg/owbox/environment
#   ~/.config/owbox/environment

sys=@sysconfdir@/xdg/owbox/environment
[ -r "$sys" ] && . "$sys"
[ "$sys" != /etc/xdg/owbox/environment ] && [ -r /etc/xdg/owbox/environment ] &&
    . /etc/xdg/owbox/environment
user=${XDG_CONFIG_HOME:-$HOME/.config}/owbox/environment
[ -r "$user" ] && . "$user"

# the SSH agent that systemd started (GNOME's, from gcr, or OpenSSH's), which
# other desktops' sessions point SSH_AUTH_SOCK at
if [ -z "$SSH_AUTH_SOCK" ] && [ -n "$XDG_RUNTIME_DIR" ]; then
    for sock in "$XDG_RUNTIME_DIR/gcr/ssh" "$XDG_RUNTIME_DIR/ssh-agent.socket"
    do
        if [ -S "$sock" ]; then
            export SSH_AUTH_SOCK="$sock"
            break
        fi
    done
fi

exec @bindir@/owbox "$@"
