<?xml version="1.0" encoding="UTF-8"?>

<!-- Do not edit this file, it will be overwritten on install.
        Copy the file to $HOME/.config/owbox/ instead.

     The root menu (right click on the desktop).  A ~/.config/openbox/menu.xml
     is used when there is no ~/.config/owbox/menu.xml.

     Menus built into owbox that can be used here:
       applications-menu          the installed applications, by category
       client-list-combined-menu  the windows on each desktop
       client-list-menu           the same, a submenu per desktop -->

<openbox_menu xmlns="http://openbox.org/3.4/menu">

<menu id="owbox-menu" label="owbox">
  <item label="Settings" icon="preferences-desktop">
    <action name="Execute">
      <command>owbox-settings</command>
    </action>
  </item>
  <item label="Reconfigure">
    <action name="Reconfigure" />
  </item>
  <item label="Edit Configuration">
    <action name="Execute">
      <command>xdg-open ~/.config/owbox/rc.xml</command>
    </action>
  </item>
</menu>

<!-- Locking runs the screen locker (swaylock), see <owbox><idle> in rc.xml.
     Suspending locks the screen first. -->
<menu id="leave-menu" label="Leave" icon="system-shutdown">
  <item label="Lock Screen" icon="system-lock-screen">
    <action name="Execute">
      <command>loginctl lock-session</command>
    </action>
  </item>
  <item label="Suspend" icon="system-suspend">
    <action name="Execute">
      <command>systemctl suspend</command>
    </action>
  </item>
  <separator />
  <item label="Log Out" icon="system-log-out">
    <action name="Exit">
      <prompt>yes</prompt>
    </action>
  </item>
  <item label="Restart" icon="system-reboot">
    <action name="Execute">
      <prompt>Restart the computer?</prompt>
      <command>systemctl reboot</command>
    </action>
  </item>
  <item label="Shut Down" icon="system-shutdown">
    <action name="Execute">
      <prompt>Shut down the computer?</prompt>
      <command>systemctl poweroff</command>
    </action>
  </item>
</menu>

<menu id="root-menu" label="owbox">
  <item label="Terminal" icon="utilities-terminal">
    <action name="Execute">
      <command>owbox-terminal</command>
    </action>
  </item>
  <item label="Files" icon="system-file-manager">
    <action name="Execute">
      <startupnotify><enabled>yes</enabled></startupnotify>
      <command>xdg-open ~</command>
    </action>
  </item>
  <separator />
  <menu id="applications-menu" />
  <menu id="client-list-combined-menu" />
  <separator />
  <menu id="owbox-menu" />
  <separator />
  <menu id="leave-menu" />
</menu>

</openbox_menu>
